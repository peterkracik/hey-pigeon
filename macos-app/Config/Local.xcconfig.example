// Copy to Local.xcconfig (git-ignored) and fill in. Same bring-your-own
// OAuth idea as the phone: a Google OAuth client of type "iOS" (no secret —
// Google has no "macOS" type, and an iOS client's reversed-id redirect works
// from a Mac app through the same consent sheet). Either reuse the phone's
// client or add a second iOS client with bundle id app.heypigeon.mac.
DEVELOPMENT_TEAM = ABCDE12345
GOOGLE_MAC_CLIENT_ID = 123456789-abcdefg.apps.googleusercontent.com
GOOGLE_MAC_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789-abcdefg
// The push relay's register-token URL: leave it empty. The Mac build has no
// push entitlement (it ships with Developer ID and no provisioning profile)
// and syncs every 30 seconds while open instead.
HEYPIGEON_RELAY_URL =
// Optional: the public half of the EdDSA key the published builds are
// signed with (publish-macos.yml; `generate_keys` prints it). Empty leaves
// in-app updates off in your own builds, which is right for development.
SPARKLE_PUBLIC_ED_KEY =
