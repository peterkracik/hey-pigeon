{
  "name": "heypigeon-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Optional relay for Hey Pigeon. Push: Gmail watch → Pub/Sub → APNs silent push (sees email + historyId). Read status: a pixel for sent mail (stores a token, a mailbox hash and open times). Never mail.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "start:register": "functions-framework --target=registerToken --signature-type=http",
    "start:opens": "functions-framework --target=opens --signature-type=http",
    "start:onchange": "functions-framework --target=onMailChange --signature-type=cloudevent"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/functions-framework": "^3.5.1",
    "@google-cloud/secret-manager": "^5.6.0"
  }
}
